{
  "name": "plex-media-tracker",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Tracks new music releases from your Plex library artists, plus films and shows on your Plex watchlist. Runs on a NAS, with an Android app that shows the same library.",
  "scripts": {
    "start": "node src/server.ts",
    "scan": "node src/scan-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "build:mobile": "node scripts/build-mobile.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
